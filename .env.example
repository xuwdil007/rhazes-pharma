PORT=4173
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-a-long-random-secret

# Docker: localhost-only by default. Set 0.0.0.0 only for direct HTTP access.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# For compose.https.yaml: a domain pointing to your server.
SITE_DOMAIN=example.com
