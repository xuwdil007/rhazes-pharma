APP_NAME="Rhazes Pharma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Dushanbe
APP_LOCALE=ru

LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/backend/data/site.db

ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Docker: localhost-only by default. Set 0.0.0.0 only for direct HTTP access.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# For compose.https.yaml: a domain pointing to your server.
SITE_DOMAIN=example.com
